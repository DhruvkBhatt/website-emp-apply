# SHA-256 of the #/management passphrase. Generate with:
#   npm run hash -- "your passphrase here"
# In CI this is injected from a repo secret of the same name (§5.5, §6) so the
# plaintext never enters git history.
VITE_MANAGEMENT_PASSPHRASE_HASH=

# Optional hint shown above the passphrase field. Should be an inside joke,
# not a security question (§10.3).
VITE_MANAGEMENT_HINT=

# Optional: overrides vite's `base`. Set to "/" when using a custom domain.
VITE_BASE=

# Optional: wa.me deep link target for "Schedule Further Clarification" (§10.5).
# Digits only, with country code, no + or spaces.
VITE_CLARIFICATION_WHATSAPP=
